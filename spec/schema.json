          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]{0,40}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "label": {
          "anyOf": [
            {
              "maxLength": 240,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "roles": {
          "anyOf": [
            {
              "items": {
                "pattern": "^[a-z][a-z0-9_]{0,40}$",
                "type": "string"
              },
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Roles"
        },
        "type": {
          "const": "browse_pick",
          "title": "Type",
          "type": "string"
        },
        "entity": {
          "pattern": "^[a-z][a-z0-9_]{0,40}$",
          "title": "Entity",
          "type": "string"
