    "App": {
      "additionalProperties": false,
      "properties": {
        "title": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "slug": {
          "pattern": "^[a-z][a-z0-9_]{0,40}$",
          "title": "Slug",
          "type": "string"
        },
        "signup_domain": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Signup Domain"
        }
      },
      "required": [
        "title",
        "slug"
      ],
      "title": "App",
      "type": "object"
    },
    "BrowseView": {
      "additionalProperties": false,
      "properties": {
