          ],
          "default": null,
          "title": "Tree"
        },
        "submit": {
          "pattern": "^[a-z][a-z0-9_]{0,40}$",
          "title": "Submit",
          "type": "string"
        }
      },
      "required": [
        "type",
        "entity",
        "submit"
      ],
      "title": "BrowseView",
      "type": "object"
