        "columns": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/ExportColumn"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Columns"
        },
        "formats": {
          "items": {
            "enum": [
              "txt",
              "csv",
              "xlsx"
