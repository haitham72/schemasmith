        "label": {
          "anyOf": [
            {
              "maxLength": 240,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "from": {
          "maxLength": 240,
          "minLength": 1,
          "title": "From",
          "type": "string"
