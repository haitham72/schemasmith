                "list<datetime>": "#/$defs/ListField",
                "list<domain>": "#/$defs/ListField",
                "list<email>": "#/$defs/ListField",
                "list<enum>": "#/$defs/EnumField",
                "list<int>": "#/$defs/ListField",
                "list<number>": "#/$defs/ListField",
                "list<ref>": "#/$defs/RefField",
                "list<text>": "#/$defs/ListField",
                "list<url>": "#/$defs/ListField",
                "number": "#/$defs/NumberField",
                "ref": "#/$defs/RefField",
                "text": "#/$defs/TextField",
                "url": "#/$defs/ScalarField"
              },
              "propertyName": "type"
            },
