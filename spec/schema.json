            "type": "string"
          },
          "minItems": 1,
          "title": "Formats",
          "type": "array"
        }
      },
      "required": [
        "name",
        "from",
        "formats"
      ],
      "title": "Export",
      "type": "object"
    },
    "ExportColumn": {
      "additionalProperties": false,
      "description": "One grouped export column over a closed selector; aggregates are closed.",
      "properties": {
        "source": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "label": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "aggregate": {
          "default": "value",
          "enum": [
            "value",
            "join_distinct",
            "none_true"
          ],
          "title": "Aggregate",
          "type": "string"
        },
        "distinct_by": {
          "anyOf": [
            {
              "maxLength": 240,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Distinct By"
        },
        "true_label": {
          "default": "yes",
          "maxLength": 80,
          "title": "True Label",
          "type": "string"
        },
        "false_label": {
          "default": "no",
          "maxLength": 80,
          "title": "False Label",
          "type": "string"
        },
        "empty": {
          "default": "",
          "maxLength": 240,
          "title": "Empty",
          "type": "string"
        }
      },
      "required": [
        "source",
        "label"
      ],
      "title": "ExportColumn",
      "type": "object"
    },
