          "denied": "DENY",
          "needs_info": "PEND",
          "pending": "PEND"
        },
        "count_value": "ALLOW",
        "total_label": "Total Allowed"
      },
      "summary": {
        "sheet": "Summary",
        "title": "ACCESS OVERVIEW",
        "headers": [
