# Required. Use a long random URL-safe value; there is no default password.
DB_PASSWORD=
DB_PORT=54321
# Empty uses the Compose database. URL-encode reserved characters in custom DSNs.
DATABASE_URL=
ADMIN_EMAILS=
SIGNUP_DOMAIN=
# 1 shows "Continue as guest" (shared non-admin account). On for local/demo use;
# set to 0 (or remove) for real deployments.
GUEST_LOGIN=1
# 1 lets guests run the AI designer with their own OpenAI key (needs SCHEMA_EDIT=1).
# On for local demos; keep 0 on shared deployments, where it would let any visitor
# change the shared schema.
GUEST_DESIGNER=1
EXAMPLE=
# Enables the designer (generate, plan, apply). On for local use; set 0 for real deployments.
SCHEMA_EDIT=1
# Model used with a user-supplied OpenAI key (default gpt-4o-mini).
OPENAI_MODEL=
# Compose service DNS; direct Python execution defaults to localhost instead.
LLM_BASE_URL=http://ollama:11434/v1
LLM_MODEL=
LLM_API_KEY=
